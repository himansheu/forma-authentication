# Copy to .env and fill in. Never commit .env.
# Generate a secret with:  npm run secret
SESSION_SECRET=change-me-generate-with-npm-run-secret

PORT=3000
NODE_ENV=development

# Where the SQLite file lives (default: ./data/forma.db)
# DATABASE_PATH=./data/forma.db

# Session lifetime in hours (default 168 = 7 days)
# SESSION_TTL_HOURS=168

# bcrypt cost factor (default 12)
# BCRYPT_ROUNDS=12

# Cookies are Secure when NODE_ENV=production. Override only if you must:
# COOKIE_SECURE=true
# Set to true when running behind a reverse proxy that terminates HTTPS
# TRUST_PROXY=true

# Failed/total attempts per IP per 15 minutes on auth endpoints (default 10)
# RATE_LIMIT_MAX=10
